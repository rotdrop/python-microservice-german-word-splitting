#!/bin/sh
set -e

if [ "$1" = configure ]; then
	if ! getent passwd german-word-splitter >/dev/null; then
		adduser --quiet --system --group --home /opt/german-word-splitter \
			--no-create-home --shell /usr/sbin/nologin german-word-splitter
	fi
	python3 -m compileall -q /opt/german-word-splitter/venv || true
fi

#DEBHELPER#

exit 0
